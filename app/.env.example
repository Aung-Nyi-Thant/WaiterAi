# Settings for running the app without Docker (copy to app/.env.local). Never commit .env.local.
# Every value is optional. See ../.env.example for the Docker version and the notes.

# ---- AI model -------------------------------------------------------------
# ollama (default): local Ollama.  openai: any OpenAI-compatible cloud API.  auto: Ollama first, cloud if it fails.
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MAX_CONCURRENCY=1     # model answers at the same time (default 1 for Ollama, 4 for a cloud model)
# AI_MAX_QUEUE=15          # calls allowed to wait; more get the "AI unavailable" message (0 = no limit)

# ---- Rate limits (see ../.env.example for what each one does; 0 switches a limit off) ----
# RATE_LIMIT_LOGIN_MAX=10          RATE_LIMIT_LOGIN_WINDOW_SEC=60
# RATE_LIMIT_CHAT_MAX=20           RATE_LIMIT_CHAT_WINDOW_SEC=60
# RATE_LIMIT_CHAT_RESTAURANT_MAX=120   RATE_LIMIT_CHAT_IP_MAX=60   RATE_LIMIT_TRUST_PROXY=0
# RATE_LIMIT_REGISTER_MAX=20   RATE_LIMIT_REGISTER_WINDOW_SEC=3600   RATE_LIMIT_REGISTER_IP_MAX=5

# ---- Storage and security ---------------------------------------------------
# DATA_DIR=./data          # database, session secret and uploaded photos
# SESSION_SECRET=          # empty = generated once into DATA_DIR/secret

# ---- Development vs production ---------------------------------------------
# `npm run dev` creates the demo restaurant with PUBLIC logins (demo@shop.ai / demo1234, PINs 1111/2222).
# With NODE_ENV=production those logins are never created: run `npm run db:seed` (see SEED_* in ../.env.example).
