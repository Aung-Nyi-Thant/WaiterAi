// Builds scripts/seed-data/hachi-kyu.json (the HaChi Kyu sushi menu) from the clickable prototype's menu (prototype/data.js).
//
//   node --experimental-strip-types --no-warnings scripts/make-hachi-kyu-seed.mts         writes the file
//   ... --check                                                                           fails when the file is out of date
//
// The prototype only knows each dish by name and a short ingredient list, so the allergens here are ESTIMATES, not the kitchen's
// word. The rules keep that safe (see docs/AI_SAFETY.md R3): an allergen is listed only when an ingredient clearly implies it, and
// a dish whose estimate is empty is stored as "not provided" (NULL), never as "none". The prototype lumped crustaceans and molluscs
// together as "shell"; the app tracks them separately, so they are split here. Vegetarian and vegan tags are not copied: the
// prototype only guessed them.
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const here = path.dirname(fileURLToPath(import.meta.url));
const out = path.join(here, "seed-data", "hachi-kyu.json");
const win: any = {};
const src = fs.readFileSync(path.join(here, "..", "..", "prototype", "data.js"), "utf8");
const { RAW, ING, CATS, ALMAP } = new Function("window", `${src}\nreturn { RAW, ING, CATS, ALMAP };`)(win) as { RAW: any[]; ING: Record<string, string[]>; CATS: any[]; ALMAP: Record<string, string[]> };

const CRUSTACEANS = ["shrimp", "sweetshrimp", "shrimproe", "softcrab", "crab"];
const MOLLUSCS = ["scallop", "squid", "octopus", "clam"];
const RULES: [string, string[]][] = [
  ["fish", ALMAP.fish], ["shellfish", CRUSTACEANS], ["molluscs", MOLLUSCS], ["egg", ALMAP.egg], ["milk", ALMAP.milk], ["gluten", ALMAP.gluten], ["soy", ALMAP.soy],
];
const ORDER = ["gluten", "shellfish", "egg", "fish", "peanut", "soy", "milk", "tree_nut", "celery", "mustard", "sesame", "sulphites", "lupin", "molluscs"];
const SPICY = /กระเพรา|โกจุงจัง|ยำ|ลาบ|กิมจิ/;
const ingName = (k: string) => (ING[k] || [k, k])[1];

const categories = CATS.filter((c: any) => c[0] !== "all" && c[0] !== "rec").map((c: any) => ({ key: c[0], th: c[2][0], en: c[2][1], my: c[2][2] }));
const items = RAW.map(([th, en, price, cats, photo, ing]: any[]) => {
  const keys: string[] = ing;
  const found = RULES.filter(([, list]) => keys.some((k) => list.includes(k))).map(([a]) => a).sort((a, b) => ORDER.indexOf(a) - ORDER.indexOf(b));
  const spicy = SPICY.test(th);
  return {
    category: cats.split(",")[0], name: { en, th }, price,
    ingredients: keys.map(ingName).join(", "),
    allergens: found.length ? found : null,
    tags: [...(keys.some((k) => k === "pork" || k === "bacon") ? ["contains_pork"] : []), ...(spicy ? ["spicy"] : [])],
    spice: spicy ? 2 : 0,
    photo,
  };
});

const data = {
  _note: "Generated by scripts/make-hachi-kyu-seed.mts from prototype/data.js. Allergens are estimated from the dish names; a dish with no clear allergen is stored as 'not provided'. Photos are links to the source site and are only used when SEED_HACHI_PHOTOS=1.",
  restaurant: { name: "HaChi Kyu", slug: "hachi-kyu", currency: "THB", hours: { open: "11:00", close: "22:00", lastOrder: "22:00", closedDays: [] } },
  categories,
  items,
  faq: [
    { q: "Are the allergen details confirmed by the kitchen?", a: "Not yet. They are estimated from the dish names, so please confirm any allergy with the staff before ordering." },
    { q: "Do you serve raw fish?", a: "Yes. Sashimi and many of our sushi are raw. Ask the staff if you are unsure." },
  ],
};
const text = `${JSON.stringify(data, null, 1)}\n`;
if (process.argv.includes("--check")) {
  // Windows checks files out with CRLF line endings: compare the content, not the line endings
  const same = fs.existsSync(out) && fs.readFileSync(out, "utf8").replace(/\r\n/g, "\n") === text;
  console.log(same ? "hachi-kyu.json is up to date" : "hachi-kyu.json is out of date: run scripts/make-hachi-kyu-seed.mts");
  process.exit(same ? 0 : 1);
}
fs.writeFileSync(out, text);
const nul = items.filter((i: any) => i.allergens === null).length;
console.log(`Wrote ${path.relative(process.cwd(), out)}: ${items.length} dishes in ${categories.length} categories; ${items.length - nul} with estimated allergens, ${nul} stored as "not provided".`);
