{
  "name": "shop-ai",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/seed.mts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/diner-filters.test.ts tests/i18n.test.ts tests/ingredients.test.ts",
    "test:integration": "vitest run tests/integration tests/ui tests/diner-flow.test.ts",
    "test:system": "npm run build && npm run test:e2e",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "typecheck": "tsc --noEmit",
    "eval:live": "node --experimental-strip-types --no-warnings scripts/eval-live.mts",
    "eval:smooth": "node --experimental-strip-types --no-warnings scripts/eval-smooth.mts",
    "lint": "biome lint .",
    "load-test": "node --experimental-strip-types --no-warnings scripts/load-test.mts",
    "db:restore-demo": "node --experimental-strip-types --no-warnings scripts/restore-demo-menu.mts",
    "db:prune-chat": "node --experimental-strip-types --no-warnings scripts/prune-chat.mts",
    "db:backup": "node --experimental-strip-types --no-warnings scripts/backup-data.mts backup",
    "db:restore": "node --experimental-strip-types --no-warnings scripts/backup-data.mts restore",
    "db:seed:hachi": "node --experimental-strip-types --no-warnings scripts/seed-hachi-kyu.mts",
    "db:seed:hachi:into": "node --experimental-strip-types --no-warnings scripts/seed-hachi-kyu.mts --into golden-lotus",
    "prototype:live": "ln -sfn ../../prototype public/prototype && echo \"Prototype with the real AI: http://localhost:3000/prototype/index.html?view=customer&ai=live\"",
    "db:seed:hachi:build": "node --experimental-strip-types --no-warnings scripts/make-hachi-kyu-seed.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
