# Copy to .env (docker compose reads it). Never commit .env.

# ---- AI model -------------------------------------------------------------
# ollama (default): local Ollama.  openai: any OpenAI-compatible cloud API.  auto: Ollama first, cloud if it fails.
AI_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
# Cloud model (AI_PROVIDER=openai or auto). AI_BASE_URL defaults to https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
# How many questions the model answers at the same time (default 1 for Ollama, 4 for a cloud model) and how many may wait
# before diners get the "AI unavailable" message (default 15, 0 = no limit). A local model is slower when run in parallel.
# AI_MAX_CONCURRENCY=1
# AI_MAX_QUEUE=15

# ---- First-start accounts (used by scripts/seed.mts in production) --------
# Leave empty to get a random password and PINs printed once in the log. The public demo logins
# (demo@shop.ai / demo1234, PINs 1111 and 2222) are refused when NODE_ENV=production.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_WAITER_PIN=
SEED_CHEF_PIN=

# ---- Rate limits (0 switches a limit off) -----------------------------------
# Failed logins per account (owner email, or the restaurant for staff PINs) and chat messages, per window.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_SEC=60
# RATE_LIMIT_CHAT_MAX=20                 # per chat session
# RATE_LIMIT_CHAT_WINDOW_SEC=60
# RATE_LIMIT_CHAT_RESTAURANT_MAX=120     # per restaurant, whatever the session
# RATE_LIMIT_CHAT_IP_MAX=60              # per client address; only with RATE_LIMIT_TRUST_PROXY=1
# RATE_LIMIT_REGISTER_MAX=20             # new owner accounts per window, whole server
# RATE_LIMIT_REGISTER_WINDOW_SEC=3600
# RATE_LIMIT_REGISTER_IP_MAX=5           # per client address; only with RATE_LIMIT_TRUST_PROXY=1
# Set to 1 ONLY behind a reverse proxy you control that appends the real client address to X-Forwarded-For.
# Without it the address is not used (a client can fake that header), so limits apply per account / session / restaurant.
# RATE_LIMIT_TRUST_PROXY=0

# ---- Security -------------------------------------------------------------
# Signs session cookies. Empty = generated once and kept in the data volume. Set a long random value to share it.
SESSION_SECRET=
